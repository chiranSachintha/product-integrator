#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BALLERINA_BIN_DIR="$SCRIPT_DIR"
ICP_UPDATE_SCRIPT="$SCRIPT_DIR/../../icp/bin/update_icp"

if [ "$#" -lt 1 ]; then
    echo "Usage: update <ballerina|icp> [args...]"
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
    ballerina)
        exec "$BALLERINA_BIN_DIR/bal" update "$@"
        ;;
    icp)
        exec "$ICP_UPDATE_SCRIPT" "$@"
        ;;
    *)
        echo "Usage: update <ballerina|icp> [args...]"
        exit 1
        ;;
esac
