#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BALLERINA_UPDATE="$APP_ROOT/components/ballerina/bin/wso2integratorupdate_dist"
ICP_BIN_DIR="$APP_ROOT/components/icp/bin"
MI_CACHE_DIR="$HOME/.wso2-mi/micro-integrator"
SI_CACHE_DIR="$HOME/.wso2-si/streaming-integrator"
PROFILE_STATE_FILE="$HOME/.wso2-integrator/selected-profile"

print_ballerina_help() {
    cat <<'EOF'
Update Ballerina connects to the WSO2 Update service, finds product updates that are
relevant to the installed Ballerina, and applies them.

To learn more about WSO2 Update, visit https://wso2.com/updates

Usage:
  wso2integratorupdate ballerina [flags]
  wso2integratorupdate ballerina [command]

Examples:
  wso2integratorupdate ballerina version
  wso2integratorupdate ballerina help check
  wso2integratorupdate ballerina
  wso2integratorupdate ballerina --username user@wso2.com --password my_password
  wso2integratorupdate ballerina --level 3.0.0.10
  wso2integratorupdate ballerina --dry-run

Available Commands:
  apply-hotfix   Apply an available hotfix.
  apply-update   Apply a created update zip file to the product.
  check          Check available new levels for the product.
  completion     Generate shell autocompletion scripts.
  create-docker  Create a Docker image of the product.
  create-update  Create an update zip file for the product.
  current-state  Show current details of the product.
  help           Help about any command.
  revert-hotfix  Revert the most recently applied hotfix.
  version        Print the update tool version information.

Flags:
  -b, --backup string     Specify updates backup directory
  -c, --channel string    Channel updates should be downloaded from (default "full")
      --continue          Merge resolved conflicts
      --dry-run           Simulate the update
  -h, --help              help for wso2integratorupdate ballerina
  -l, --level string      Level in which the product should be updated to
      --no-backup         Skip product backup
  -p, --password string   Specify your WSO2 account password
      --revert            Revert to the previous update level
      --template string   Specify the template output
  -u, --username string   Specify your WSO2 account email
  -v, --verbose           Enable verbose mode
EOF
}

print_icp_help() {
    cat <<'EOF'
Update ICP connects to the WSO2 Update service, finds product updates that are
relevant to the installed WSO2 Integration Control Plane, and applies them.

To learn more about WSO2 Update, visit https://wso2.com/updates

Usage:
  wso2integratorupdate icp [flags]
  wso2integratorupdate icp [command]

Examples:
  wso2integratorupdate icp version
  wso2integratorupdate icp help check
  wso2integratorupdate icp
  wso2integratorupdate icp --username user@wso2.com --password my_password
  wso2integratorupdate icp --level 3.0.0.10
  wso2integratorupdate icp --dry-run

Available Commands:
  apply-hotfix   Apply an available hotfix.
  apply-update   Apply a created update zip file to the product.
  check          Check available new levels for the product.
  completion     Generate shell autocompletion scripts.
  create-docker  Create a Docker image of the product.
  create-update  Create an update zip file for the product.
  current-state  Show current details of the product.
  help           Help about any command.
  revert-hotfix  Revert the most recently applied hotfix.
  version        Print the update tool version information.

Flags:
  -b, --backup string     Specify updates backup directory
  -c, --channel string    Channel updates should be downloaded from (default "full")
      --continue          Merge resolved conflicts
      --dry-run           Simulate the update
  -h, --help              help for wso2integratorupdate icp
  -l, --level string      Level in which the product should be updated to
      --no-backup         Skip product backup
  -p, --password string   Specify your WSO2 account password
      --revert            Revert to the previous update level
      --template string   Specify the template output
  -u, --username string   Specify your WSO2 account email
  -v, --verbose           Enable verbose mode
EOF
}

run_icp_update() {
    if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "help" ]; then
        print_icp_help
        exit 0
    fi

    local icp_update_tool
    icp_update_tool="$(find "$ICP_BIN_DIR" -maxdepth 1 -type f -name 'wso2update_*' -perm -111 | head -1)"

    if [ -z "$icp_update_tool" ] || [ ! -x "$icp_update_tool" ]; then
        if [ ! -x "$ICP_BIN_DIR/update_tool_setup.sh" ]; then
            echo "Error: update_tool_setup.sh not found in $ICP_BIN_DIR"
            exit 1
        fi

        (cd "$ICP_BIN_DIR" && ./update_tool_setup.sh)
        icp_update_tool="$(find "$ICP_BIN_DIR" -maxdepth 1 -type f -name 'wso2update_*' -perm -111 | head -1)"
    fi

    if [ -z "$icp_update_tool" ] || [ ! -x "$icp_update_tool" ]; then
        echo "Error: ICP update executable not found in $ICP_BIN_DIR"
        exit 1
    fi

    exec "$icp_update_tool" "$@"
}

if [ "$#" -lt 1 ]; then
    :
fi

read_selected_profile_command() {
    if [ ! -f "$PROFILE_STATE_FILE" ]; then
        echo "ballerina"
        return
    fi

    local selected_profile
    selected_profile="$(tr -d '\r' < "$PROFILE_STATE_FILE" 2>/dev/null | head -n 1)"
    case "$selected_profile" in
        "WSO2 Integrator: MI")
            echo "mi"
            ;;
        "WSO2 Integrator: SI")
            echo "si"
            ;;
        *)
            echo "ballerina"
            ;;
    esac
}

if [ "$#" -ge 1 ]; then
    case "$1" in
        -h|--help|help)
            echo "Usage: update [flags]"
            echo "Usage: update <ballerina|icp|mi|si> [args...]"
            exit 0
            ;;
        ballerina|icp|mi|si)
            COMMAND="$1"
            shift
            COMMAND_ARGS=("$@")
            ;;
        -*)
            COMMAND="$(read_selected_profile_command)"
            COMMAND_ARGS=("$@")
            ;;
        *)
            echo "Usage: update [flags]"
            echo "Usage: update <ballerina|icp|mi|si> [args...]"
            exit 1
            ;;
    esac
else
    COMMAND="$(read_selected_profile_command)"
    COMMAND_ARGS=()
fi

case "$COMMAND" in
    ballerina)
        if [ "${COMMAND_ARGS[0]:-}" = "-h" ] || [ "${COMMAND_ARGS[0]:-}" = "--help" ]; then
            print_ballerina_help
            exit 0
        fi
        exec "$BALLERINA_UPDATE" "${COMMAND_ARGS[@]}"
        ;;
    icp)
        run_icp_update "${COMMAND_ARGS[@]}"
        ;;
    mi)
        case "${COMMAND_ARGS[0]:-}" in
            -h|--help|help)
                cat <<'EOF'
Update MI connects to the WSO2 Update service, finds product updates that are
relevant to the installed MI, and applies them.

To learn more about WSO2 Update, visit https://wso2.com/updates

Usage:
  wso2integratorupdate mi [flags]
  wso2integratorupdate mi [command]

Examples:
  wso2integratorupdate mi version
  wso2integratorupdate mi help check
  wso2integratorupdate mi
  wso2integratorupdate mi --username user@wso2.com --password my_password
  wso2integratorupdate mi --level 3.0.0.10
  wso2integratorupdate mi --dry-run

Available Commands:
  apply-hotfix   Apply an available hotfix.
  apply-update   Apply a created update zip file to the product.
  check          Check available new levels for the product.
  completion     Generate shell autocompletion scripts.
  create-docker  Create a Docker image of the product.
  create-update  Create an update zip file for the product.
  current-state  Show current details of the product.
  help           Help about any command.
  revert-hotfix  Revert the most recently applied hotfix.
  version        Print the update tool version information.

Flags:
  -b, --backup string     Specify updates backup directory
  -c, --channel string    Channel updates should be downloaded from (default "full")
      --continue          Merge resolved conflicts
      --dry-run           Simulate the update
  -h, --help              help for wso2integratorupdate mi
  -l, --level string      Level in which the product should be updated to
      --no-backup         Skip product backup
  -p, --password string   Specify your WSO2 account password
      --revert            Revert to the previous update level
      --template string   Specify the template output
  -u, --username string   Specify your WSO2 account email
  -v, --verbose           Enable verbose mode
EOF
                exit 0
                ;;
        esac

        MI_UPDATE_TOOL="$(find "$MI_CACHE_DIR" -type f -path '*/bin/wso2update_linux' -perm -111 2>/dev/null | sort -V | tail -1)"
        if [ -z "$MI_UPDATE_TOOL" ]; then
            MI_UPDATE_TOOL="$(find "$MI_CACHE_DIR" -type f -path '*/bin/wso2update_*' -perm -111 2>/dev/null | sort -V | tail -1)"
        fi
        if [ -z "$MI_UPDATE_TOOL" ]; then
            echo "Error: MI update executable not found for Linux. Please open/create a MI project. MI not in your machine."
            exit 1
        fi

        exec "$MI_UPDATE_TOOL" "${COMMAND_ARGS[@]}"
        ;;
    si)
        case "${COMMAND_ARGS[0]:-}" in
            -h|--help|help)
                cat <<'EOF'
Update SI connects to the WSO2 Update service, finds product updates that are
relevant to the installed SI, and applies them.

To learn more about WSO2 Update, visit https://wso2.com/updates

Usage:
  wso2integratorupdate si [flags]
  wso2integratorupdate si [command]

Examples:
  wso2integratorupdate si version
  wso2integratorupdate si help check
  wso2integratorupdate si
  wso2integratorupdate si --username user@wso2.com --password my_password
  wso2integratorupdate si --level 3.0.0.10
  wso2integratorupdate si --dry-run

Available Commands:
  apply-hotfix   Apply an available hotfix.
  apply-update   Apply a created update zip file to the product.
  check          Check available new levels for the product.
  completion     Generate shell autocompletion scripts.
  create-docker  Create a Docker image of the product.
  create-update  Create an update zip file for the product.
  current-state  Show current details of the product.
  help           Help about any command.
  revert-hotfix  Revert the most recently applied hotfix.
  version        Print the update tool version information.

Flags:
  -b, --backup string     Specify updates backup directory
  -c, --channel string    Channel updates should be downloaded from (default "full")
      --continue          Merge resolved conflicts
      --dry-run           Simulate the update
  -h, --help              help for wso2integratorupdate si
  -l, --level string      Level in which the product should be updated to
      --no-backup         Skip product backup
  -p, --password string   Specify your WSO2 account password
      --revert            Revert to the previous update level
      --template string   Specify the template output
  -u, --username string   Specify your WSO2 account email
  -v, --verbose           Enable verbose mode
EOF
                exit 0
                ;;
        esac

        SI_UPDATE_TOOL="$(find "$SI_CACHE_DIR" -type f -path '*/bin/wso2update_linux' -perm -111 2>/dev/null | sort -V | tail -1)"
        if [ -z "$SI_UPDATE_TOOL" ]; then
            SI_UPDATE_TOOL="$(find "$SI_CACHE_DIR" -type f -path '*/bin/wso2update_*' -perm -111 2>/dev/null | sort -V | tail -1)"
        fi
        if [ -z "$SI_UPDATE_TOOL" ]; then
            echo "Error: SI update executable not found for Linux. Please open/create a SI project. SI not in your machine."
            exit 1
        fi

        exec "$SI_UPDATE_TOOL" "${COMMAND_ARGS[@]}"
        ;;
    *)
        echo "Usage: update <ballerina|icp|mi|si> [args...]"
        exit 1
        ;;
esac
